[models]
planner = "gpt-5.6-luna"
worker_fast = "gpt-5.3-codex-spark"
lead = "gpt-5.6-luna"
complex_lead = "gpt-5.6-terra"
manager = "gpt-5.4-mini"
worker_medium = "gpt-5.4-mini"
worker_deep = "gpt-5.6-luna"
consult_ambiguous = "gpt-5.6-terra"
consult_high_risk = "gpt-5.6-sol"
reasoning_effort = "medium"

[scheduler]
max_agents = 4
hard_max_agents = 8
usage_reserve_percent = 12.0
question_policy = "only_blocking"

[context]
# Optional compatibility ceiling. Omit to use provider/model capabilities.
# context_limit = 200000
fact_limit = 24
recent_turns = 8

[permissions]
remote_writes = "ask"
destructive = "ask"

[cache]
enabled = true
max_bytes = 536870912
max_age_days = 30
hot_entries = 128

[memory]
enabled = true
use_memory = true
generate = true
retrieval_limit = 5

[budgets]
default = "balanced"
# Legacy DeepSeek-only reserve keys remain readable. Prefer the provider-keyed
# table below for new configuration.
deepseek_soft_reserve_percent = 10.0
deepseek_hard_reserve_percent = 2.0

[budgets.provider_reserves.chatgpt_codex]
soft_percent = 10.0
hard_percent = 2.0

[budgets.provider_reserves.deepseek]
soft_percent = 10.0
hard_percent = 2.0

[budgets.provider_reserves.xiaomi_mimo]
soft_percent = 10.0
hard_percent = 2.0

# Optional, explicit routing controls. A pin can only narrow an otherwise
# eligible role pool; it cannot bypass capability, health, or safety checks.
[routing.pins]
# worker = "deepseek/deepseek-v4-flash"

# Per-provider overrides are intentionally opt-in. `false` bypasses the named
# reserve or cooldown only; it never changes tool or credential permissions.
[routing.providers.deepseek]
# reserve = false
# cooldown = false

[books]
enabled = true

[tui]
mouse = true
tool_detail = "compact"
theme = "dark"
surface_renderer = "auto"
reduced_motion = false
